# Application environment
APP_ENV=development

# SQLite database path
# This file will be created automatically if it does not exist
DB_PATH=./data/app.db

# Root directory for raw meteo data (used by local ingestion helper)
DATA_ROOT=./data/raw

# API settings (optional, mainly for documentation)
API_HOST=0.0.0.0
API_PORT=8000

# Logging
LOG_LEVEL=INFO
